# Kopieren nach .env.local und ausfüllen. .env* ist in .gitignore.

# Postgres auf Neon (gepoolte Verbindung)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# better-auth
BETTER_AUTH_URL=http://localhost:3000
# z. B. mit `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Anmeldung mit Google (optional; ohne diese Werte ist der Google-Button ohne Funktion)
# Redirect-URI in der Google Cloud Console: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pusher (optional; ohne diese Werte läuft alles, aber nicht live)
# Die App unter dashboard.pusher.com anlegen, Werte unter "App Keys".
# Key und Cluster brauchen auch die Browser, daher mit VITE_.
PUSHER_APP_ID=
PUSHER_SECRET=
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=eu
